# ==============================================================================
# 🚀 VMES V2.0 - ENV CONFIGURATION TEMPLATE (ไฟล์แม่แบบการตั้งค่าระบบ)
# ==============================================================================
# หมายเหตุ: ไฟล์นี้เป็นแม่แบบสำหรับ Git repository (ห้ามใส่ Secret จริงในนี้)
# กรุณาคัดลอกไปสร้างไฟล์ .env และกำหนดค่าจริงบน Vercel Dashboard

# ==============================================================================
# 🏥 1. ระบบยืนยันตัวตนกระทรวงสาธารณสุข (MOPH ID: Health ID & Provider ID)
# ==============================================================================
# สภาพแวดล้อมระบบ MOPH ID (prd = ใช้งานจริง moph.id.th / uat = ระบบทดสอบ uat-moph.id.th)
MOPH_ENV=prd

# ค่าตั้งค่า Health ID OAuth Client
HEALTHID_CLIENT_ID=your_healthid_client_id_here
HEALTHID_CLIENT_SECRET=your_healthid_client_secret_here
HEALTHID_REDIRECT_URI=https://vmes-backend.vercel.app/api/auth/healthid/callback

# ค่าตั้งค่า Provider ID Profile Service
PROVIDERID_CLIENT_ID=your_providerid_client_id_here
PROVIDERID_SECRET_KEY=your_providerid_secret_key_here

# รหัสหน่วยบริการ (HCODE) ที่อนุญาตให้เข้าใช้งาน (เช่น 10866 = รพ.คลองหาด, คั่นด้วย , ถ้ามีหลายแห่ง)
MOPH_ALLOWED_HCODES=10866

# ==============================================================================
# 🔑 2. การตั้งค่าเซสชันและการเข้าสู่ระบบ (Session & System Authorization)
# ==============================================================================
# URL หลักของระบบ Frontend (ใช้สำหรับ CORS และ Redirect)
FRONTEND_URL=https://vmes.web.app

# คีย์ลับสำหรับ Sign / Verify HMAC Session Token (ความยาวอย่างน้อย 32 ตัวอักษร)
# สร้างสุ่มได้ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=your_random_32char_session_secret_key_here

# ระยะเวลาหมดอายุของ Session Token (หน่วยเป็นชั่วโมง)
SESSION_HOURS=12

# รหัสผ่านผู้ดูแลระบบระดับสูงกรณีฉุกเฉิน (Admin Backup Code)
ADMIN_CODE=11192

# ==============================================================================
# 🌐 3. ระบบส่งต่อสัญญาณ MOPH Relay (ไทยแลนด์ เซิร์ฟเวอร์ Relay)
# ==============================================================================
# (ใช้สำหรับ bypass กรณี Vercel IP ต่างประเทศถูกบล็อกโดย moph.id.th)
MOPH_TOKEN_RELAY_URL=
MOPH_RELAY_KEY=
