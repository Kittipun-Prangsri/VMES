# ── MOPH ID (Health ID + Provider ID) ─────────────────────────────────
# ไฟล์นี้เป็นแม่แบบ (อยู่ใน git) — ห้ามใส่ค่าจริง ค่าจริงใส่ใน .env และ Vercel env
# callback ที่ลงทะเบียนกับ MOPH: https://vmes-backend.vercel.app/api/auth/healthid/callback
MOPH_ENV=prd                         # prd = moph.id.th / provider.id.th ; uat = uat-*
HEALTHID_CLIENT_ID=
HEALTHID_CLIENT_SECRET=
HEALTHID_REDIRECT_URI=https://vmes-backend.vercel.app/api/auth/healthid/callback
PROVIDERID_CLIENT_ID=
PROVIDERID_SECRET_KEY=
# รหัสหน่วยบริการ (hcode) ที่อนุญาต คั่นด้วย , — เว้นว่าง = ทุกหน่วยบริการ (แต่ต้องรอ admin อนุมัติ)
MOPH_ALLOWED_HCODES=

# ── Session ───────────────────────────────────────────────────────────
FRONTEND_URL=https://vmes.web.app
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_HOURS=12

# ── Relay (moph.id.th บล็อก IP นอกประเทศไทย รวมถึง Vercel) ───────────
# URL ของ relay บนเซิร์ฟเวอร์ในไทยที่ส่งต่อไป https://moph.id.th/api/v1/token
MOPH_TOKEN_RELAY_URL=
# ค่าลับที่ relay ตรวจใน header X-Relay-Key
MOPH_RELAY_KEY=
