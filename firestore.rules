rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------
    // Security Rules สำหรับระบบบริหารยานพาหนะและยืม-คืนอุปกรณ์ V2.0
    // -------------------------------------------------------------
    // หมายเหตุ: backend เขียน/อ่านข้อมูลผ่าน Server Admin SDK (Supabase service_role / Firebase Admin)
    // ซึ่งเป็นการเรียกแบบมีสิทธิ์สูง (bypass security rules) จึงปิดการเขียนจาก client ฝั่งเบราว์เซอร์ทั้งหมด

    // เก็บรหัสผ่านผู้ใช้แยกจาก collection "users" — ปิดทั้งอ่านและเขียนจากทุกคน (backend เท่านั้น)
    match /userCredentials/{docId} {
      allow read, write: if false;
    }

    // provider_id ของ MOPH ID -> รหัสผู้ใช้ (backend เท่านั้น)
    match /mophLinks/{docId} {
      allow read, write: if false;
    }

    // ประวัติการบันทึกระบบ (Audit Log) ห้ามอ่านโดยตรงจากเบราว์เซอร์ (เข้าถึงผ่าน API Backend เท่านั้น)
    match /audit/{docId} {
      allow read, write: if false;
    }

    // ข้อมูลทั่วไปสำหรับการแสดงผลฝั่ง Client (ยกเว้น collection พิเศษด้านบน)
    match /{collection}/{docId} {
      allow read: if collection != 'userCredentials' && collection != 'mophLinks' && collection != 'audit';
      allow write: if false;
    }
  }
}
